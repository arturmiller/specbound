{
  "apiVersion": "specbound.example/v1alpha1",
  "kind": "EvidenceProviderPack",
  "metadata": {
    "id": "org.specbound.example-license",
    "version": "1.0.0",
    "title": "Example license evidence"
  },
  "runtime": {
    "kind": "approved-container",
    "image": "registry.example/auth-example@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    "input": "contracts/request.json",
    "output": "contracts/response.json"
  },
  "capabilities": [
    {
      "id": "python.package-license",
      "version": "v1",
      "outputSchema": "schemas/license.json"
    }
  ],
  "permissions": {
    "github": [
      "contents:read"
    ]
  }
}
