{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:specbound:contracts:v1:control-bindings",
  "title": "ControlBindings",
  "type": "object",
  "properties": {
    "apiVersion": {
      "const": "specbound.example/v1alpha1"
    },
    "kind": {
      "const": "ControlBindings"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[A-Za-z0-9.-]+)?(?:\\+[A-Za-z0-9.-]+)?$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "\\S"
        }
      },
      "required": [
        "id",
        "version",
        "name"
      ],
      "additionalProperties": false
    },
    "spec": {
      "type": "object",
      "properties": {
        "catalog": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
            },
            "version": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[A-Za-z0-9.-]+)?(?:\\+[A-Za-z0-9.-]+)?$"
            }
          },
          "required": [
            "id",
            "version"
          ],
          "additionalProperties": false
        },
        "controls": {
          "type": "array",
          "minItems": 1,
          "items": {
            "allOf": [
              {
                "$ref": "urn:specbound:contracts:v1:governance-control"
              },
              {
                "properties": {
                  "assertions": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 32,
                    "items": {
                      "$ref": "#/$defs/rule"
                    }
                  }
                }
              }
            ]
          }
        }
      },
      "required": [
        "catalog",
        "controls"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "additionalProperties": false,
  "$defs": {
    "rule": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "operator": {
              "const": "equals"
            },
            "path": {
              "type": "string",
              "maxLength": 500,
              "pattern": "^[A-Za-z_][A-Za-z0-9_-]*(?:\\.[A-Za-z_][A-Za-z0-9_-]*)*$"
            },
            "expected": {},
            "expectedParameter": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "operator",
            "path"
          ],
          "additionalProperties": false,
          "oneOf": [
            {
              "required": [
                "expected"
              ],
              "not": {
                "required": [
                  "expectedParameter"
                ]
              }
            },
            {
              "required": [
                "expectedParameter"
              ],
              "not": {
                "required": [
                  "expected"
                ]
              }
            }
          ]
        },
        {
          "type": "object",
          "properties": {
            "operator": {
              "const": "exists"
            },
            "path": {
              "type": "string",
              "maxLength": 500,
              "pattern": "^[A-Za-z_][A-Za-z0-9_-]*(?:\\.[A-Za-z_][A-Za-z0-9_-]*)*$"
            }
          },
          "required": [
            "operator",
            "path"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "operator": {
              "enum": [
                "all",
                "any"
              ]
            },
            "assertions": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "$ref": "#/$defs/rule"
              }
            }
          },
          "required": [
            "operator",
            "assertions"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "operator": {
              "const": "spdx-allowlist"
            },
            "path": {
              "type": "string",
              "maxLength": 500,
              "pattern": "^[A-Za-z_][A-Za-z0-9_-]*(?:\\.[A-Za-z_][A-Za-z0-9_-]*)*$"
            },
            "allowed": {
              "type": "array",
              "minItems": 1,
              "maxItems": 100,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "allowedParameter": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "operator",
            "path"
          ],
          "additionalProperties": false,
          "oneOf": [
            {
              "required": [
                "allowed"
              ],
              "not": {
                "required": [
                  "allowedParameter"
                ]
              }
            },
            {
              "required": [
                "allowedParameter"
              ],
              "not": {
                "required": [
                  "allowed"
                ]
              }
            }
          ]
        }
      ]
    }
  }
}
