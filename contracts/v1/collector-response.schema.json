{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:specbound:contracts:v1:collector-response",
  "type": "object",
  "properties": {
    "schemaVersion": {"const": 1},
    "observations": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "subjectId": {"$ref": "urn:specbound:contracts:v1:common#/$defs/identifier"},
          "capability": {"type": "string", "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+/v[1-9][0-9]*$"},
          "scope": {"$ref": "urn:specbound:contracts:v1:common#/$defs/scope", "required": ["environment", "targetRevision"]},
          "observedAt": {"$ref": "urn:specbound:contracts:v1:common#/$defs/timestamp"},
          "provenance": {"$ref": "urn:specbound:contracts:v1:common#/$defs/provenance"},
          "value": {}
        },
        "required": ["subjectId", "capability", "scope", "observedAt", "provenance", "value"],
        "additionalProperties": false
      }
    }
  },
  "required": ["schemaVersion", "observations"],
  "additionalProperties": false
}
