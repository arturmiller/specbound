{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:specbound:contracts:v1:governance-pack",
  "title": "Governance Pack v1alpha1",
  "type": "object",
  "properties": {
    "apiVersion": {"const": "specbound.example/v1alpha1"},
    "kind": {"const": "GovernancePack"},
    "metadata": {
      "type": "object",
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,199}$"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[A-Za-z0-9.-]+)?(?:\\+[A-Za-z0-9.-]+)?$"},
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string"}
      },
      "required": ["id", "version"],
      "additionalProperties": false
    },
    "controls": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "requiresCapabilities": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+/v[1-9][0-9]*$"}
    }
  },
  "required": ["apiVersion", "kind", "metadata", "controls", "requiresCapabilities"],
  "additionalProperties": false
}
