{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:specbound:contracts:v1:governance-control",
  "title": "Governance Control v1alpha1",
  "type": "object",
  "properties": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "target": {"type": "object", "properties": {"kind": {"type": "string", "minLength": 1, "pattern": "\\S"}}, "required": ["kind"], "additionalProperties": false},
    "requiredEvidence": {
      "type": "object",
      "properties": {"capability": {"type": "string", "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+/v[1-9][0-9]*$"}},
      "required": ["capability"], "additionalProperties": false
    },
    "assertions": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "properties": {"operator": {"type": "string", "minLength": 1, "pattern": "\\S"}}, "required": ["operator"]}
    }
  },
  "required": ["id", "target", "requiredEvidence", "assertions"],
  "additionalProperties": false
}
