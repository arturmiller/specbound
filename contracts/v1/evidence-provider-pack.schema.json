{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:specbound:contracts:v1:evidence-provider-pack",
  "title": "Evidence Provider Pack v1alpha1",
  "type": "object",
  "properties": {
    "apiVersion": {"const": "specbound.example/v1alpha1"},
    "kind": {"const": "EvidenceProviderPack"},
    "metadata": {
      "type": "object",
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,199}$"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[A-Za-z0-9.-]+)?(?:\\+[A-Za-z0-9.-]+)?$"},
        "title": {"type": "string", "minLength": 1},
        "description": {"type": "string"}
      },
      "required": ["id", "version"], "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "properties": {
        "kind": {"const": "approved-container"},
        "image": {"type": "string", "maxLength": 500, "pattern": "^[A-Za-z0-9][A-Za-z0-9./:_-]*@sha256:[0-9a-f]{64}$"},
        "entrypoint": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "input": {"type": "string", "minLength": 1},
        "output": {"type": "string", "minLength": 1}
      },
      "required": ["kind", "image", "input", "output"], "additionalProperties": false
    },
    "capabilities": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$"},
          "version": {"type": "string", "pattern": "^v[1-9][0-9]*$"},
          "outputSchema": {"type": "string", "minLength": 1}
        },
        "required": ["id", "version", "outputSchema"], "additionalProperties": false
      }
    },
    "permissions": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "string", "minLength": 1}}},
    "tests": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "required": ["apiVersion", "kind", "metadata", "runtime", "capabilities"],
  "additionalProperties": false
}
