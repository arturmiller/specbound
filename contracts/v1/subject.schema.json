{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:specbound:contracts:v1:subject",
  "title": "Subject v1",
  "type": "object",
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"$ref": "urn:specbound:contracts:v1:common#/$defs/identifier"},
    "type": {"$ref": "urn:specbound:contracts:v1:common#/$defs/identifier"},
    "labels": {"type": "object", "additionalProperties": {"type": "string"}},
    "scope": {"$ref": "urn:specbound:contracts:v1:common#/$defs/scope"},
    "provenance": {"$ref": "urn:specbound:contracts:v1:common#/$defs/provenance"},
