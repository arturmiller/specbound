{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:specbound:contracts:v1:common",
  "$defs": {
    "identifier": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "scope": {
      "type": "object",
      "properties": {
        "productId": {"$ref": "#/$defs/identifier"},
        "environment": {"$ref": "#/$defs/identifier"},
        "targetRevision": {"$ref": "#/$defs/identifier"}
      },
      "required": ["productId"],
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {
        "sourceRef": {"$ref": "#/$defs/identifier"},
        "sourceRevision": {"$ref": "#/$defs/identifier"},
        "collectorRevision": {"$ref": "#/$defs/identifier"}
      },
      "required": ["sourceRef"],
      "additionalProperties": false
    },
    "timestamp": {"type": "string", "format": "date-time"}
  }
}
